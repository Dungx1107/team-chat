# App Config
PROJECT_NAME="Team Chat API"
ENVIRONMENT="development"
PORT=8000

# Database (Supabase PostgreSQL qua Pooler IPv4)
DATABASE_URL=postgresql://postgres.your-project-ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
SUPABASE_STORAGE_BUCKET=attachments

# Security
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# IP LAN cua may chay server (cach nhau dau phay) de chung chi HTTPS khop khi vao tu thiet bi khac
CERT_IPS=
# Cong HTTPS/HTTP cua nginx
HTTPS_PORT=443
HTTP_PORT=80
# May chu STUN/TURN cho cuoc goi WebRTC.
#
# Chi gioi han trong LAN: de nguyen dong duoi day.
# Muon goi qua Internet: them TURN (co tai khoan). Vi du voi Metered --
# thay <username> va <password> bang thong tin cua ban, tat ca tren MOT dong:
#
# ICE_SERVERS=[{"urls":"stun:stun.relay.metered.ca:80"},{"urls":"turn:global.relay.metered.ca:80","username":"<username>","credential":"<password>"},{"urls":"turn:global.relay.metered.ca:443","username":"<username>","credential":"<password>"},{"urls":"turns:global.relay.metered.ca:443?transport=tcp","username":"<username>","credential":"<password>"}]
#
# Kiem tra sau khi doi:  docker compose exec backend python check_turn.py
ICE_SERVERS=stun:stun.l.google.com:19302

# Cong noi bo danh cho tunnel (cloudflared/ngrok) khi goi qua Internet
TUNNEL_PORT=8080

# TURN noi bo de thu (chi dung khi chay: docker compose --profile turn up -d)
# Phai la IP LAN that, khong dung 127.0.0.1
TURN_EXTERNAL_IP=
TURN_USER=test
TURN_PASSWORD=test123
