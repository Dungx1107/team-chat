# App Config
PROJECT_NAME="Team Chat API"
ENVIRONMENT="development"
PORT=8000

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=teamchat_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_postgres_password_here@db:5432/teamchat_db

# Security
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# IP LAN cua may chay server (cach nhau dau phay) de chung chi HTTPS khop khi vao tu thiet bi khac
CERT_IPS=
# Cong HTTPS/HTTP cua nginx
HTTPS_PORT=443
HTTP_PORT=80
# May chu STUN cho cuoc goi WebRTC; de trong neu chi dung trong LAN
ICE_SERVERS=stun:stun.l.google.com:19302
